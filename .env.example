# ===================================================
# QUICKSTOCK AI - Environment Configuration Example
# ===================================================

# Node API Configuration
API_PORT=5001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=super-secret-jwt-session-key-change-in-production-min-32-chars

# MongoDB Database Configuration
# Local default:
MONGODB_URI=mongodb://127.0.0.1:27017/quickstock_ai
# Production / MongoDB Atlas template:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/quickstock_ai?retryWrites=true&w=majority
MONGODB_DB_NAME=quickstock_ai

# Python ML Microservice Configuration
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TOKEN=qs-internal-auth-token-quickstock-secure-key-2026
ML_PORT=8000

# File Storage & Artifacts (Absolute or relative to monorepo root)
ARTIFACT_DIR=artifacts
DATA_DIR=data

# Application Modes
DEMO_MODE=true

# Optional Kaggle API Integration (for direct kaggle CLI dataset download)
# Set your Kaggle username and API key if using automated dataset retrieval:
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_api_key
